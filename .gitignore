# Ignore all generated data by default
data/*

# But keep folder + documentation
!data/.gitkeep
!data/README.md

# Optionally keep small reference files
!data/schema.json

# Small result tables are the project's findings; keep them visible
!data/ablation_results.csv
!data/final_test_results.csv
!data/model_comparison.csv
!data/ridge_weather_ablation.csv
!data/rolling_origin_mae.csv
!data/severe_weather_effects.csv
!data/dispatch_type_map.csv
!data/weather_effects_by_type.csv

# Ignore model outputs / plots
plots/*
!plots/model_comparison.png
!plots/severe_weather_effect.png
!plots/weather_effects_by_type.png
models/*
checkpoints/*

# Python junk
__pycache__/
*.pyc
*.pyo
*.pyd

# OS junk
.DS_Store

# Virtual environment
.venv/
